---
services:
  {{ APP }}:
    image: {{ IMAGE_NAME }}:{{ IMAGE_TAG }}
    container_name: {{ APP }}
    hostname: {{ APP }}
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    env_file: .env
    volumes:
      - /opt/stacks/{{ APP }}/config:/app/data:rw
    ports:
      - {{ PORT_NUMBER }}:{{ DEFAULT_PORT_NUMBER }}/tcp
    healthcheck:
      disable: true
    user: 1000:1000
    networks:
      - {{ NETWORK }}

networks:
  {{ NETWORK }}:
    external: true
