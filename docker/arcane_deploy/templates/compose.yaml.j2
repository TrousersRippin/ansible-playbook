---
services:
  {{ APP }}:
    image: {{ IMAGE_NAME }}:{{ IMAGE_TAG }}
    container_name: {{ APP }}
    hostname: {{ APP }}
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    env_file: .env
    volumes:
      - /opt/stacks/{{ APP }}/data:/data:rw
      - /opt/stacks:/opt/stacks:rw
      - /var/run/docker.sock:/var/run/docker.sock
    ports:
      - {{ PORT_NUMBER }}:{{ PORT_NUMBER }}/tcp
    healthcheck:
      disable: true
    group_add: [987]
    networks:
      - {{ NETWORK }}

networks:
  {{ NETWORK }}:
    external: true
