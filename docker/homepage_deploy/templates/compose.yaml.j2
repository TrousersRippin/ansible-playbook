---
services:
  {{ APP }}:
    image: {{ IMAGE_NAME }}:{{ IMAGE_TAG }}
    container_name: {{ APP }}
    hostname: {{ APP }}
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      - TZ=Europe/Stockholm
      - HOMEPAGE_ALLOWED_HOSTS=*
    volumes:
      - /opt/stacks/{{ APP }}/config:/config:rw
      - /var/run/docker.sock:/var/run/docker.sock:ro
    ports:
      - {{ PORT_NUMBER }}:{{ PORT_NUMBER }}/tcp
    healthcheck:
      disable: true
    networks:
      - {{ NETWORK }}

networks:
  {{ NETWORK }}:
    external: true
