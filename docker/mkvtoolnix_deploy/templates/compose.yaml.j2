---
services:
  {{ APP }}:
    image: {{ IMAGE_NAME }}:{{ IMAGE_TAG }}
    container_name: {{ APP }}
    hostname: {{ APP }}
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      - TZ=Europe/Stockholm
      - PUID=1000
      - PGID=1000
      - DARK_MODE=1
    volumes:
      - /opt/stacks/{{ APP }}/config:/config:rw
      - /home/{{ USER }}:/storage:rw
    ports:
      - {{ PORT_NUMBER }}:{{ PORT_NUMBER }}/tcp
    networks:
      - {{ NETWORK }}

networks:
  {{ NETWORK }}:
    external: true
